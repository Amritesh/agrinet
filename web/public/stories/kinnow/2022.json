[701,663]},{"kind":"gap","headline":"Gap ₹1,250/qtl","caption":"The median gap was ₹1,250 per quintal, and Kangra (Baijnath) was dearer on 100% of days.","camera":"corridor","focus":[701,663],"chart":"gap"},{"kind":"route","headline":"251 km by road","caption":"251 km on OpenStreetMap roads (~4 hours by car). A loaded truck is slower, so we allow 1 days plus 7 days to get paid.","camera":"corridor","focus":[701,663],"route":"solan-kangra","truck":true},{"kind":"costs","headline":"After modeled costs","caption":"Freight ≈₹54/qtl, 5% fees and commission, loading, 5% loss and interest. On the typical day ₹816 per quintal was left.","camera":"corridor","focus":[701,663],"route":"solan-kangra","chart":"waterfall"},{"kind":"stress","headline":"Still positive under stress","caption":"With 25% dearer freight, 10% loss and costlier credit, the typical day still kept ₹589 per quintal.","camera":"corridor","focus":[701,663],"route":"solan-kangra","chart":"waterfall"},{"kind":"strategy","headline":"A trader who only knew the morning's news","caption":"Using only the latest available Kangra (Baijnath) report, the rule selects 21 of 21 modeled shipping days. 21 had positive modeled net, averaging ₹819 per quintal (₹613 under stress).","camera":"corridor","focus":[701,663],"route":"solan-kangra","chart":"strategy"},{"kind":"conclusion","headline":"The back-test","caption":"The modeled Kinnow route from Solan to Kangra (Baijnath) was positive on 100% of matched days in December 2022. At that average, a 100-quintal (10-tonne) load implies ₹81,900, or ₹61,300 under stress. Actual buyer, capacity, haggling, rejection and delays are unknown.","camera":"corridor","focus":[701,663],"route":"solan-kangra"}],"assumptions":[{"kind":"sourced","item":"Freight","value":"≈₹240 per quintal Nashik→Delhi","source":"rbi-wps-depr-08-2024"},{"kind":"assumption","item":"Freight for this product","value":"onion survey freight applied per quintal to kinnow","source":null},{"kind":"assumption","item":"Fr