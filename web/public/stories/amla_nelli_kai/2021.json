on could absorb more supply; no capital-constrained or volume allocation optimum is claimed.","Costs extrapolate onion survey values (including to other crops) plus stated allowances, not freight quotes; OSRM car routing, not a verified truck route. Representative town points may not be at mandi gates.","Historical: this says what paid then, not what pays today."]},"facts":{"n":29,"buy_median":3000,"sell_median":3900,"gross_median":800,"persistence_pct":100,"km":278.3,"hours":4.41,"transit_days":1,"freight":60,"wf_base":{"buy":3200.0,"freight":59.91,"fees":160.0,"loading":9.02,"loss":200.0,"interest":9.02,"sell":4000.0,"net":362.05,"buy_date":"2021-10-21","sell_date":"2021-10-22"},"wf_adverse":{"buy":3200.0,"freight":74.89,"fees":160.0,"loading":9.02,"loss":400.0,"interest":10.57,"sell":4000.0,"net":145.52,"buy_date":"2021-10-21","sell_date":"2021-10-22"},"paying_days":26,"paying_pct":90,"inf_shipped":26,"inf_considered":29,"inf_won":23,"inf_losing":3,"inf_mean":453,"inf_adverse":239,"n_checked":6,"variety":"Other","grade":"FAQ","net_baseline":362,"net_adverse":146,"margin_pct":15.1,"truck_qtl":100,"truck_t":10,"settle_days":7,"truck_inr":45300,"truck_adverse_inr":23900},"markets":[{"id":960,"name":"Kattappana","state":"Kerala","district":"Idukki","lat":9.75617,"lon":77.11406,"precision":"representative town/place (not the mandi gate)"},{"id":1037,"name":"Kondotty","state":"Kerala","district":"Malappuram","lat":11.14572,"lon":75.96438,"precision":"representative town/place (not the mandi gate)"}],"routes":[{"slug":"kattappana-kondotty","path":[[77.1142,9.7565],[77.1088,9.7664],[77.0882,9.7695],[77.0564,9.8006],[76.9983,9.8391],[76.9817,9.8693],[76.9684,9.8803],[76.9702,9.905],[76.9551,9.9195],[76.9683,9.9197],[76.9638,9.9366],[76.9691,9.935],[76.9815,9.9507],[76.944,9.9649],[76.843,10.0226],[76.8315,10.0223],[76.7707,10.0527],[76.7214,10.0492],[76.6877,10.0604],[76.6389,10.059],[76.5756,10.0806],[76.533,10.1107],[76.4778,10.1146],[76.4608,10.1454],[76.4386,10.1663],