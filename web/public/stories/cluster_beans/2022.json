oday."]},"facts":{"n":25,"buy_median":3000,"sell_median":4000,"gross_median":1000,"persistence_pct":88,"km":380.4,"hours":6.57,"transit_days":1,"freight":82,"wf_base":{"buy":3000.0,"freight":81.89,"fees":150.0,"loading":9.02,"loss":200.0,"interest":8.52,"sell":4000.0,"net":550.57,"buy_date":"2022-12-14","sell_date":"2022-12-16"},"wf_adverse":{"buy":3000.0,"freight":102.36,"fees":150.0,"loading":9.02,"loss":400.0,"interest":10.01,"sell":4000.0,"net":328.61,"buy_date":"2022-12-14","sell_date":"2022-12-16"},"paying_days":21,"paying_pct":84,"inf_shipped":19,"inf_considered":25,"inf_won":19,"inf_losing":0,"inf_mean":648,"inf_adverse":433,"n_checked":60,"variety":"Other","grade":"FAQ","net_baseline":551,"net_adverse":329,"margin_pct":21.6,"truck_qtl":100,"truck_t":10,"settle_days":7,"truck_inr":64800,"truck_adverse_inr":43300},"markets":[{"id":1026,"name":"Palayam","state":"Kerala","district":"Kozhikode (Calicut)","lat":11.24814,"lon":75.78465,"precision":"representative town/place (not the mandi gate)"},{"id":1096,"name":"Chala","state":"Kerala","district":"Thiruvananthapuram","lat":8.48309,"lon":76.95218,"precision":"representative town/place (not the mandi gate)"}],"routes":[{"slug":"palayam-chala","path":[[75.7843,11.248],[75.7962,11.2163],[75.8296,11.1893],[75.8288,11.1815],[75.8291,11.1802],[75.8293,11.1795],[75.8295,11.1788],[75.8298,11.178],[75.8122,11.1537],[75.8536,11.0722],[75.8754,10.9822],[75.918,10.9192],[75.9522,10.8198],[75.9652,10.8193],[75.9541,10.7941],[75.9287,10.7635],[75.9334,10.7466],[75.9437,10.7392],[76.019,10.5782],[76.025,10.5809],[76.0453,10.5429],[76.0476,10.5286],[76.1187,10.3903],[76.1235,10.3656],[76.1546,10.2943],[76.1676,10.2902],[76.1835,10.2599],[76.1951,10.2326],[76.2016,10.1893],[76.2116,10.1766],[76.2143,10.1516],[76.2234,10.1513],[76.2554,10.0907],[76.2666,10.0921],[76.2866,10.0681],[76.3105,10.0207],[76.3192,9.9632],[76.3317,9.9501],[76.3449,9.9544],[76.3616,9.9213],[76.3994,9.7963],[76.3958,9.7577],[76.4021,9.7584],[76.4012,9.7404