ess).","camera":"corridor","focus":[573,663],"route":"thanesar-kangra","chart":"strategy"},{"kind":"conclusion","headline":"The back-test","caption":"The modeled Colacasia route from Thanesar to Kangra (Baijnath) was positive on 89% of matched days in July 2025. At that average, a 100-quintal (10-tonne) load implies ₹65,100, or ₹46,200 under stress. Actual buyer, capacity, haggling, rejection and delays are unknown.","camera":"corridor","focus":[573,663],"route":"thanesar-kangra"}],"assumptions":[{"kind":"sourced","item":"Freight","value":"≈₹240 per quintal Nashik→Delhi","source":"rbi-wps-depr-08-2024"},{"kind":"assumption","item":"Freight for this product","value":"onion survey freight applied per quintal to colacasia","source":null},{"kind":"assumption","item":"Freight on other distances","value":"scaled by road km against the 1,115 km Lasalgaon→Azadpur route → ₹68/qtl here","source":null},{"kind":"sourced","item":"Mandi fee + commission","value":"1% + 4% of purchase value","source":"rbi-wps-depr-08-2024"},{"kind":"sourced","item":"Loading/unloading","value":"₹9.02 per quintal","source":"rbi-wps-depr-08-2024"},{"kind":"assumption","item":"Weight & quality loss in transit","value":"5% baseline, 10% adverse","source":null},{"kind":"assumption","item":"Working capital","value":"12% a year (14% adverse) for transit + 7 days","source":null},{"kind":"assumption","item":"Adverse freight","value":"+25% over baseline","source":null},{"kind":"assumption","item":"Truck transit","value":"~450 road km a day → 1 days here","source":null}],"trades":[{"buy":"2025-07-01","sell":"2025-07-02","buy_price":3000.0,"sell_price":4100.0,"gross":1100.0,"net_baseline":659.96,"net_adverse":436.62,"informed_ship":true},{"buy":"2025-07-02","sell":"2025-07-03","buy_price":3000.0,"sell_price":4100.0,"gross":1100.0,"net_baseline":659.96,"net_adverse":436.62,"informed_ship":true},{"buy":"2025-07-03","sell":"2025-07-04","buy_price":3000.0,"sell_price":4100.0,"gross":1100.0,"net_baseline":659.96,"ne