n points may not be at mandi gates.","Historical: this says what paid then, not what pays today."]},"facts":{"n":12,"buy_median":3200,"sell_median":4350,"gross_median":1150,"persistence_pct":92,"km":232.2,"hours":3.3,"transit_days":1,"freight":50,"wf_base":{"buy":3200.0,"freight":49.99,"fees":160.0,"loading":9.02,"loss":210.0,"interest":8.99,"sell":4200.0,"net":562.0,"buy_date":"2025-08-25","sell_date":"2025-08-26"},"wf_adverse":{"buy":3200.0,"freight":62.49,"fees":160.0,"loading":9.02,"loss":420.0,"interest":10.53,"sell":4200.0,"net":337.96,"buy_date":"2025-08-25","sell_date":"2025-08-26"},"paying_days":10,"paying_pct":83,"inf_shipped":12,"inf_considered":12,"inf_won":10,"inf_losing":2,"inf_mean":586,"inf_adverse":352,"n_checked":2424,"variety":"Tomato","grade":"FAQ","net_baseline":562,"net_adverse":338,"margin_pct":18.3,"truck_qtl":100,"truck_t":10,"settle_days":7,"truck_inr":58600,"truck_adverse_inr":35200},"markets":[{"id":565,"name":"Ladwa","state":"Haryana","district":"Kurukshetra","lat":30.03462,"lon":77.04859,"precision":"representative town/place (not the mandi gate)"},{"id":708,"name":"Una","state":"Himachal Pradesh","district":"Una","lat":31.58333,"lon":76.25,"precision":"representative town/place (not the mandi gate)"}],"routes":[{"slug":"ladwa-una","path":[[77.0482,30.0348],[77.0413,30.0239],[77.0316,30.0237],[77.0032,30.0568],[76.9119,30.1392],[76.8634,30.1638],[76.8526,30.2331],[76.8526,30.2771],[76.8345,30.3353],[76.8019,30.3574],[76.7782,30.4289],[76.8041,30.5075],[76.847,30.5879],[76.846,30.5975],[76.8246,30.6202],[76.8206,30.6586],[76.7903,30.7035],[76.7666,30.6892],[76.7222,30.7431],[76.7018,30.7313],[76.6412,30.7498],[76.5939,30.8093],[76.5716,30.8131],[76.5613,30.8212],[76.564,30.8548],[76.5303,30.9541],[76.5371,30.9848],[76.5914,31.0199],[76.5988,31.0776],[76.6146,31.0969],[76.591,31.1144],[76.5775,31.1442],[76.5807,31.1523],[76.5582,31.1991],[76.5345,31.2193],[76.5034,31.2287],[76.4768,31.2536],[76.443,31.2715],[76.3756,31.3657],[76.3742,31.3